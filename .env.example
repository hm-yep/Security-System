# 复制本文件为 .env 后填入本机数据库口令；.env 已被 .gitignore 排除，不要提交。
SECURITY_DB_HOST=localhost
SECURITY_DB_USER=root
SECURITY_DB_PASSWORD=replace_me
SECURITY_DB_NAME=Security_System_Users_DataBase

# 后端选择：mysql | sqlite。源码运行默认 mysql；打包版默认 sqlite（免安装）。
# SECURITY_DB_BACKEND=sqlite
# SECURITY_DB_PATH=D:/data/security.db

